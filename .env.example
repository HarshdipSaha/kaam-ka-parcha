API_KEY=replace_me   # one Gnani key, or several separated by commas; a key refused with 401/403 (e.g. credits spent) is retired and the next is used
EXTRACTOR_BASE_URL=http://localhost:8080/v1
EXTRACTOR_API_KEY=
# Extraction runs on any OpenAI-compatible endpoint. Gnani Evon v3.3 (Apache-2.0 weights) can be self-hosted
# with vLLM, but Gnani publishes no hosted Evon API. Set EXTRACTOR_PROVIDER=evon only when the model served is Evon.
EXTRACTOR_MODEL=replace_with_served_model_name
EXTRACTOR_PROVIDER=openai
TTS_VOICE=Vikrant
# Public-demo guards (off when unset/0). See docs/deploy.md.
# RATE_LIMIT_PER_MINUTE=10
# SESSIONS_PER_IP_PER_HOUR=20
# MAX_TOTAL_SESSIONS=300
# MAX_UPLOAD_BYTES=8388608
# MAX_SPEECH_CALLS_PER_DAY=500   # app-wide cap on credit-spending calls per rolling 24 h
# DEMO_ACCESS_CODE=
# TRUST_PROXY=1
USE_AUTOMOTIVE_BIAS=true
# Optional advice on unclear replies; never confirms or edits the card.
JEV_REVIEW_ENABLED=0
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=20000
TELEPHONY_CODEC=g711
TELEPHONY_TARGET_SNR_DB=5.0
TELEPHONY_NOISE_PATH=data/real_world_samples/car_engine_idle_16k.wav
# CAPTION_PARTIALS=0   # interim captions are on by default (undocumented x-partials header); 0 = finals only
# AUDIO_CLEANUP=1   # high-pass + denoise before Prisma (off until measured)

# Real customer phone call via Twilio (optional; the in-browser simulated line works without these).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# PUBLIC_BASE_URL=https://<service>.onrender.com   # this app's own public HTTPS URL
# PARCHA_MOCK=1      # scripted speech services for a keyless demo; never on the public deployment
